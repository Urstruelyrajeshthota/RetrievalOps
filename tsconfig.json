{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020"],
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": ".",
    "paths": {
      "@retrievalops/core": ["packages/core/src"],
      "@retrievalops/contracts": ["packages/contracts/src"],
      "@retrievalops/evaluator": ["packages/evaluator/src"],
      "@retrievalops/observability": ["packages/observability/src"],
      "@retrievalops/cli": ["packages/cli/src"],
      "@retrievalops/pgvector": ["packages/adapters/pgvector/src"],
      "@retrievalops/qdrant": ["packages/adapters/qdrant/src"],
      "@retrievalops/opensearch": ["packages/adapters/opensearch/src"],
      "@retrievalops/weaviate": ["packages/adapters/weaviate/src"],
      "@retrievalops/openai": ["packages/embeddings/openai/src"],
      "@retrievalops/gemini": ["packages/embeddings/gemini/src"],
      "@retrievalops/local": ["packages/embeddings/local/src"],
      "@retrievalops/cross-encoder": ["packages/rerankers/cross-encoder/src"],
      "@retrievalops/llm": ["packages/rerankers/llm/src"]
    }
  },
  "include": ["packages/*/src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
