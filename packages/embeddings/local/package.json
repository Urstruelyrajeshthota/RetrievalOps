{
  "name": "@itsrajeshthota/retrievalops-local",
  "version": "0.1.0",
  "description": "Local embedding provider using transformers.js for RetrievalOps",
  "license": "Apache-2.0",
  "author": "RetrievalOps Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/retrievalops/retrievalops.git",
    "directory": "packages/embeddings/local"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "vitest",
    "lint": "eslint src --max-warnings 0",
    "type-check": "tsc --noEmit",
    "format": "prettier --write 'src/**/*.{ts,tsx}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx}'"
  },
  "dependencies": {
    "@itsrajeshthota/retrievalops-contracts": "*",
    "@xenova/transformers": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "peerDependencies": {
    "@retrievalops/core": "^0.1.0 || ^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

