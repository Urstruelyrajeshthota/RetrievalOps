{
  "name": "@retrievalops/evaluator",
  "version": "0.1.0",
  "description": "Evaluation framework for measuring retrieval quality",
  "license": "Apache-2.0",
  "author": "RetrievalOps Contributors",
  "repository": {
    "type": "git",
