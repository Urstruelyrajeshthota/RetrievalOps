{
  "name": "@itsrajeshthota/retrievalops-cli",
  "version": "0.2.1",
  "private": true,
  "description": "Command-line interface for RetrievalOps",
  "license": "Apache-2.0",
  "author": "RetrievalOps Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/retrievalops/retrievalops.git",
    "directory": "packages/cli"
  },
  "bin": {
    "retrievalops": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "vitest",
    "lint": "eslint src --max-warnings 0",
    "type-check": "tsc --noEmit",
    "format": "prettier --write 'src/**/*.{ts,tsx}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx}'"
  },
  "dependencies": {
    "@itsrajeshthota/retrievalops-core": "*",
    "@itsrajeshthota/retrievalops-evaluator": "*",
    "yargs": "^17.7.0",
    "chalk": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}


