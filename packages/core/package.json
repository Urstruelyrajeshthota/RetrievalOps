{
  "name": "@rajeshthota/retrievalops-core",
  "version": "0.1.0",
  "description": "RetrievalOps core SDK for planning, executing, and evaluating retrieval",
  "license": "Apache-2.0",
  "author": "RetrievalOps Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/retrievalops/retrievalops.git",
    "directory": "packages/core"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:security": "vitest run --grep 'security|isolation|permission'",
    "lint": "eslint src --max-warnings 0",
    "type-check": "tsc --noEmit",
    "format": "prettier --write 'src/**/*.{ts,tsx}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx}'"
  },
  "dependencies": {
    "@rajeshthota/retrievalops-contracts": "*",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "peerDependencies": {},
  "engines": {
    "node": ">=18.0.0"
  }
}
