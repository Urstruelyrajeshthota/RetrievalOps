{
  "name": "retrievalops-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "The open control plane for reliable AI retrieval",
  "author": "RetrievalOps Contributors",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*",
    "packages/adapters/*",
    "packages/embeddings/*",
    "packages/rerankers/*",
    "examples/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:security": "turbo run test:security",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "type-check": "turbo run type-check",
    "dev": "turbo run dev --parallel",
    "clean": "turbo run clean && rm -rf node_modules",
    "version": "changeset version",
    "release": "turbo run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "turbo": "^1.10.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
